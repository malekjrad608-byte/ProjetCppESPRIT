QWidget { font-family:'Segoe UI'; font-size:12px; color:#2B414A; }
QMainWindow, QDialog { background:#F4F7F8; }
QLabel { border:none; background:transparent; }
QLabel[role="muted"] { color:#81939B; font-size:12px; }
QLabel[role="eyebrow"] { color:#90A1A8; font-size:10px; font-weight:600; letter-spacing:1.7px; }
QLabel[role="title"] { font-size:29px; font-weight:700; color:#294751; }
QLabel[role="section"] { font-size:16px; font-weight:600; }
QLabel[role="error"] { color:#AB5757; background:#FBECEB; border-radius:7px; padding:10px; }
QFrame#sidebar { background:white; border-right:1px solid #E3EAED; }
QFrame#topbar { background:white; border-bottom:1px solid #E3EAED; }
QFrame[role="card"] { background:white; border:1px solid #E2E9EC; border-radius:13px; }
QFrame#workspace { background:#F0F6F7; border:1px solid #E1ECEE; border-radius:10px; }
QFrame#sidebarTip { background:#FFF6E5; border:1px solid #F3E7CD; border-radius:12px; }
QFrame#hero { background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #DFEFF1,stop:1 #EDF5F5); border:1px solid #D5E7EA; border-radius:16px; }
QPushButton { background:white; border:1px solid #DCE6EA; border-radius:8px; padding:8px 13px; font-weight:600; color:#54747E; }
QPushButton:hover { background:#F0F6F7; border-color:#AAC9CF; }
QPushButton:pressed { background:#DDECEF; }
QPushButton:focus { border:1px solid #39818F; }
QPushButton:disabled { color:#A9B6BB; background:#F3F6F7; border-color:#E8EEF0; }
QPushButton[role="primary"] { background:#397F8B; border-color:#397F8B; color:white; }
QPushButton[role="primary"]:hover { background:#2F6F7B; }
QPushButton[role="primary"]:disabled { background:#ADC7CC; border-color:#ADC7CC; }
QPushButton[role="danger"] { color:#AD6561; border-color:#EFDCD9; background:#FFF9F7; }
QPushButton[role="link"] { background:transparent; border:none; color:#397F8B; padding:5px 2px; }
QPushButton[role="nav"] { background:transparent; border:none; color:#7C9098; text-align:left; padding:13px 15px; font-weight:500; }
QPushButton[role="nav"]:hover { background:#F3F7F8; color:#347B88; }
QPushButton[role="nav"]:checked { background:#E3F0F2; color:#347B88; font-weight:700; }
QPushButton[role="toggle"] { padding:6px 10px; font-size:11px; }
QPushButton[role="toggle"]:checked { background:#E9F2F3; border-color:#C6DFE3; color:#377F8D; }
QLineEdit, QComboBox, QDateEdit, QTimeEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit { background:white; border:1px solid #DBE6EA; border-radius:7px; padding:8px 10px; color:#3D5963; selection-background-color:#DDECEF; selection-color:#2C606D; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border-color:#448A97; }
QLineEdit:disabled, QTimeEdit:disabled { background:#F2F5F6; color:#9DAEB5; }
QComboBox { padding-right:22px; }
QComboBox QAbstractItemView { background:white; selection-background-color:#E5F0F2; selection-color:#2B6774; border:1px solid #DCE7EA; padding:5px; }
QTableWidget { background:white; border:none; selection-background-color:#EDF5F6; selection-color:#2A4C57; }
QTableWidget::item { border-bottom:1px solid #EEF2F4; padding:9px 10px; }
QTableWidget::item:focus { outline:none; }
QHeaderView::section { background:#F8FAFB; border:none; border-bottom:1px solid #E9EFF1; color:#8A9AA1; font-size:10px; font-weight:600; padding:13px 10px; }
QScrollArea { border:none; background:transparent; }
QScrollBar:vertical { border:none; background:transparent; width:8px; margin:2px; }
QScrollBar::handle:vertical { background:#CADADF; border-radius:3px; min-height:30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:none; }
QScrollBar:horizontal { border:none; background:transparent; height:8px; }
QScrollBar::handle:horizontal { background:#CADADF; border-radius:3px; min-width:30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width:0; }
QProgressBar { background:#EDF3F4; border:none; border-radius:3px; min-height:6px; max-height:6px; }
QProgressBar::chunk { background:#5C9FAB; border-radius:3px; }
QToolTip { background:#2D515B; color:white; border:none; padding:8px; }
QCheckBox { spacing:8px; }
QCheckBox::indicator { width:15px; height:15px; }
QDialogButtonBox { background:transparent; }
QCalendarWidget QWidget { background:white; color:#2B414A; }
QCalendarWidget QToolButton { background:#EBF3F5; color:#2B6874; padding:5px; }
QMenu { background:white; border:1px solid #E1E9EC; padding:6px; }
QMenu::item { padding:8px 24px; }
QMenu::item:selected { background:#E6F1F4; }

QTabBar#rhTabs::tab { background:transparent;color:#718A92;padding:11px 13px;border-bottom:3px solid transparent;font-weight:600; }
QTabBar#rhTabs::tab:selected { background:#E4EFF1;color:#2D7380;border-bottom:3px solid #E9A33A; }
QTabBar#rhTabs::tab:hover { background:#EDF4F5;color:#2D7380; }
