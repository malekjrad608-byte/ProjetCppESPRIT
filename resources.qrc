<RCC>
    <qresource prefix="/">
        <file>style.qss</file>
        <file>logo.png</file>
        <file>arrow.svg</file>
        <file alias="brand/logo.png">service/resources/brand/logo.png</file>
        <file alias="icons/down.xpm">service/resources/icons/down.xpm</file>
        <file alias="icons/up.xpm">service/resources/icons/up.xpm</file>
        <file alias="service_theme.qss">service/resources/service_theme.qss</file>
        <file alias="dossiers/style.qss">dossiers/dossiers.qss</file>
        <file alias="icons/chevron.svg">dossiers/icons/chevron.svg</file>
        <file alias="icons/search_grey.svg">dossiers/icons/search_grey.svg</file>
        <file alias="icons/paw.svg">dossiers/icons/paw.svg</file>
        <file alias="assets/logo.png">logo.png</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="logo.png">logo.png</file>
        <file alias="check.svg">login_assets/check.svg</file>
    </qresource>
</RCC>
