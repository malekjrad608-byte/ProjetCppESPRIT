/* ============================================================
   ANIWORLD — Design Vibrant 2026
   ============================================================ */

/* ==================== GLOBAL ==================== */
QWidget {
    background-color: #EEF3F7;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1E3A42;
}

QMainWindow, QDialog {
    background-color: #EEF3F7;
}

/* ==================== SIDEBAR ==================== */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:0.5 #F8FBFD, stop:1 #EEF7FA);
    border-right: 2px solid #D7E9ED;
}

QLabel#logo {
    color: #1E3A42;
    font-size: 20px;
    font-weight: 900;
    padding: 0;
    margin: 0;
    background: transparent;
    letter-spacing: 1px;
}

QLabel#logoSubtitle {
    color: #4A92A0;
    font-size: 8px;
    padding: 0;
    margin: 0;
    letter-spacing: 2px;
    font-weight: bold;
    background: transparent;
}

QLabel#sectionTitle {
    color: #7A8B8F;
    font-size: 10px;
    font-weight: 900;
    padding: 18px 20px 8px 20px;
    letter-spacing: 2px;
}

QFrame#centreCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                 stop:0 #B8E0E9, stop:1 #7FB8C4);
    border-radius: 14px;
    margin: 0 15px;
    border: 2px solid #FFFFFF;
}

QPushButton#menuButton {
    background-color: transparent;
    color: #4A5A62;
    text-align: left;
    padding: 14px 22px;
    border: none;
    border-left: 4px solid transparent;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    margin: 3px 12px;
}

QPushButton#menuButton:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #E4F0F3, stop:1 #F0F8FA);
    color: #1E5A68;
    border-left: 4px solid #4A92A0;
    padding-left: 26px;
}

QPushButton#menuButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                 stop:0 #A8D4DE, stop:1 #C8E5EC);
    color: #0F3D48;
    font-weight: 900;
    border-left: 4px solid #1E3A42;
}

QPushButton#menuButton:disabled {
    color: #B0BEC4;
}

QLabel#footerText {
    font-size: 11px;
    color: #7A8B8F;
    padding: 5px;
    font-weight: 600;
}

QLabel#footerSub {
    font-size: 10px;
    color: #B0BEC4;
}

/* ==================== TOP BAR ==================== */
QFrame#topBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:1 #F5FAFC);
    border-bottom: 2px solid #D7E9ED;
}

QLabel#breadcrumb {
    font-size: 14px;
    color: #4A5A62;
    font-weight: 600;
}

QLabel#userLabel {
    font-size: 13px;
    color: #4A5A62;
    padding: 0 15px;
    font-weight: 600;
}

QPushButton#btnDemo {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #A8D4DE, stop:1 #7FB8C4);
    color: #0F3D48;
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#btnDemo:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #B8E0E9, stop:1 #92C5CF);
    border: 2px solid #4A92A0;
}

QPushButton#btnFichier {
    background-color: #FFFFFF;
    color: #1E5A68;
    border: 2px solid #D7E9ED;
    border-radius: 10px;
    padding: 8px 35px 8px 18px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#btnFichier:hover {
    background-color: #EEF7FA;
    border: 2px solid #4A92A0;
}

QPushButton#btnFichier::menu-indicator {
    image: url(:/arrow.svg);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    margin-right: 10px;
}

/* ==================== BOUTONS ==================== */
QPushButton#btnPrimary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #4A92A0, stop:1 #1E5A68);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 14px 26px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QPushButton#btnPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #5AA3B3, stop:1 #2E6E7C);
}

QPushButton#btnPrimary:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #1E5A68, stop:1 #0F3D48);
}

QPushButton#btnSecondary {
    background-color: #FFFFFF;
    color: #1E5A68;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    padding: 12px 22px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#btnSecondary:hover {
    background-color: #EEF7FA;
    border: 2px solid #4A92A0;
    color: #0F3D48;
}

QPushButton#btnDanger {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #D07872, stop:1 #A04F49);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 14px 26px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#btnDanger:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #E08884, stop:1 #B55F59);
}

QPushButton#btnSuccess {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #68BD7A, stop:1 #3E8A4F);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 14px 26px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#btnSuccess:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #78CD8A, stop:1 #4E9A5F);
}

/* ==================== CARDS ==================== */
QFrame#card {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 16px;
}

QFrame#cardStat {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 14px;
}

QLabel#cardTitle {
    color: #7A8B8F;
    font-size: 11px;
    font-weight: 700;
}

QLabel#cardValue {
    color: #1E5A68;
    font-size: 28px;
    font-weight: 900;
}

QLabel#cardValueSecondary {
    color: #A0B0B6;
    font-size: 10px;
}

QLabel#pageTitle {
    color: #1E5A68;
    font-size: 30px;
    font-weight: 900;
    letter-spacing: 0.5px;
}

QLabel#pageSubtitle {
    color: #7A8B8F;
    font-size: 13px;
}

/* ==================== CARDS EMPLOYÉ ==================== */
QFrame#cardEmploye {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:1 #F8FCFD);
    border: 2px solid #D7E9ED;
    border-radius: 18px;
}

QFrame#cardEmploye:hover {
    border: 2px solid #4A92A0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:1 #EEF7FA);
}

QFrame#cardEmployeSelected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:1 #FFF6E5);
    border: 3px solid #E8A13F;
    border-radius: 18px;
}

QFrame#cardEmployeSelected:hover {
    border: 3px solid #D89020;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #FFFFFF, stop:1 #FFEDD0);
}

/* ==================== TABLEAU ==================== */
QTableWidget {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    gridline-color: #EEF3F7;
    font-size: 12px;
    selection-background-color: #D7E9ED;
    selection-color: #1E5A68;
    alternate-background-color: #FAFCFD;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #EEF3F7;
}

QTableWidget::item:selected {
    background-color: #D7E9ED;
    color: #1E5A68;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #4A92A0, stop:1 #2E6E7C);
    color: #FFFFFF;
    padding: 14px 8px;
    border: none;
    font-weight: 900;
    font-size: 11px;
    letter-spacing: 1px;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}

QTableCornerButton::section {
    background-color: #2E6E7C;
    border: none;
}

/* ==================== CHAMPS ==================== */
QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 13px;
    color: #1E3A42;
    selection-background-color: #4A92A0;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #4A92A0;
    background-color: #FFFFFF;
}

QLineEdit:hover, QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 2px solid #A8D4DE;
}

QLineEdit#searchField {
    padding: 12px 18px;
    border-radius: 14px;
    font-size: 13px;
    background-color: #FFFFFF;
    font-weight: 600;
}

QLineEdit#searchField:focus {
    border: 2px solid #4A92A0;
    background-color: #FFFFFF;
}

/* ==================== COMBOBOX ==================== */
QComboBox {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    padding: 10px 14px;
    padding-right: 35px;
    font-size: 13px;
    color: #1E3A42;
    min-width: 150px;
    font-weight: 600;
}

QComboBox:hover {
    border: 2px solid #A8D4DE;
}

QComboBox:focus {
    border: 2px solid #4A92A0;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    background: transparent;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(:/arrow.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    padding: 6px;
    selection-background-color: #D7E9ED;
    selection-color: #1E5A68;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px;
    border-radius: 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EEF7FA;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #D7E9ED;
    color: #1E5A68;
    font-weight: 700;
}

/* ==================== DATEEDIT ==================== */
QDateEdit::drop-down {
    border: none;
    width: 25px;
    background: transparent;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #4A92A0;
    selection-color: #FFFFFF;
}

QCalendarWidget QToolButton {
    background-color: #FFFFFF;
    color: #1E5A68;
    border: none;
    padding: 5px 10px;
    font-weight: 700;
}

QCalendarWidget QToolButton:hover {
    background-color: #EEF7FA;
    border-radius: 4px;
}

/* ==================== CHECKBOX ==================== */
QCheckBox {
    color: #1E3A42;
    font-size: 13px;
    spacing: 10px;
    font-weight: 600;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    border: 2px solid #D7E9ED;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #4A92A0;
}

QCheckBox::indicator:checked {
    background-color: #1E5A68;
    border: 2px solid #1E5A68;
}

/* ==================== SCROLLBAR ==================== */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #B8D4DA;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4A92A0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #B8D4DA;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4A92A0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== MESSAGE BOX ==================== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1E3A42;
    font-size: 13px;
}

QMessageBox QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #4A92A0, stop:1 #1E5A68);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 700;
}

/* ==================== DIALOG ==================== */
QDialog {
    background-color: #EEF3F7;
}

QDialogButtonBox QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #4A92A0, stop:1 #1E5A68);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 800;
    min-width: 110px;
}

QDialogButtonBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                 stop:0 #5AA3B3, stop:1 #2E6E7C);
}

/* ==================== QLABEL ==================== */
QLabel {
    background-color: transparent;
    color: #1E3A42;
}

/* ==================== MENU ==================== */
QMenu {
    background-color: #FFFFFF;
    border: 2px solid #D7E9ED;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 12px 28px 12px 18px;
    border-radius: 8px;
    font-size: 13px;
    color: #1E3A42;
    font-weight: 600;
}

QMenu::item:selected {
    background-color: #EEF7FA;
    color: #1E5A68;
}

QMenu::separator {
    height: 1px;
    background-color: #D7E9ED;
    margin: 6px 10px;
}

/* ==================== PROGRESS BAR ==================== */
QProgressBar {
    background-color: #EEF3F7;
    border-radius: 6px;
    border: none;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 6px;
}

/* ==================== TOOLTIP ==================== */
QToolTip {
    background-color: #1E5A68;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}
/* ============================================================
   MODULE LOCAUX — intégré dans l'application principale
   ============================================================ */
QWidget#gestionLocauxPage {
    background-color: #F4F7F8;
}
QStackedWidget#localPages {
    background-color: #F4F7F8;
}
QWidget#gestionLocauxPage QLabel#pageTitle {
    color: #2F6E7E;
    font-size: 26px;
    font-weight: 700;
}
QWidget#gestionLocauxPage QLabel#pageSub {
    color: #6B7B82;
    font-size: 12px;
}
QWidget#gestionLocauxPage QLabel#emptyLabel {
    color: #8A989E;
    font-size: 13px;
    padding: 40px;
}
QPushButton#primaryBtn {
    background-color: #4A8797;
    color: #FEFEFE;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    min-height: 20px;
}
QPushButton#primaryBtn:hover { background-color: #5690A2; }
QPushButton#primaryBtn:pressed { background-color: #3A6F7D; }
QPushButton#primaryBtn:disabled { background-color: #C9DBE0; color: #F4F7F8; }
QPushButton#outlineBtn {
    background-color: #FFFFFF;
    color: #263B43;
    border: 1px solid #D5DEE1;
    border-radius: 8px;
    padding: 9px 18px;
    min-height: 20px;
    font-weight: 600;
}
QPushButton#outlineBtn:hover { background-color: #F3F7F8; }
QPushButton#outlineBtn:pressed { background-color: #E9F0F2; }
QPushButton#outlineBtn:disabled { background-color: #F6F8F9; color: #A9B5BA; border: 1px solid #E3E9EB; }
QPushButton#dangerBtn {
    background-color: #FFFFFF;
    color: #B54A3A;
    border: 1px solid #EBC9C3;
    border-radius: 8px;
    padding: 9px 18px;
    min-height: 20px;
    font-weight: 600;
}
QPushButton#dangerBtn:hover { background-color: #FDF1EF; }
QPushButton#dangerBtn:disabled { background-color: #F6F8F9; color: #C7B3B0; border: 1px solid #E9E3E2; }
QWidget#gestionLocauxPage QLabel#pillDispo,
QWidget#gestionLocauxPage QLabel#pillOccupe,
QWidget#gestionLocauxPage QLabel#pillHors {
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}
QWidget#gestionLocauxPage QLabel#pillDispo { background-color: #DDEEE3; color: #2E6B4F; }
QWidget#gestionLocauxPage QLabel#pillOccupe { background-color: #E4E8F6; color: #3D4A8A; }
QWidget#gestionLocauxPage QLabel#pillHors { background-color: #FCE9CF; color: #9A5B12; }
QWidget#gestionLocauxPage QFrame#salleCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E9EB;
    border-radius: 12px;
}
QWidget#gestionLocauxPage QFrame#salleCard:hover { border: 1px solid #BFD6DC; }
QWidget#gestionLocauxPage QFrame#salleCard[selected="true"] {
    background-color: #FFF8EC;
    border: 2px solid #E8B565;
}
QWidget#gestionLocauxPage QLabel#cardBadge {
    background-color: #E3EFE9;
    color: #2E6B4F;
    border-radius: 7px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 600;
}
QWidget#gestionLocauxPage QLabel#cardTitle {
    color: #2B4B57;
    font-size: 15px;
    font-weight: 700;
}
QWidget#gestionLocauxPage QLabel#cardSub {
    color: #7A8A91;
    font-size: 12px;
}
QWidget#gestionLocauxPage QLabel#cardInfo {
    color: #6B7B82;
    font-size: 12px;
}
QWidget#gestionLocauxPage QLabel#cardPill {
    border-radius: 7px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QWidget#gestionLocauxPage QLabel#cardPill[etat="dispo"] { background-color: #DDEEE3; color: #2E6B4F; }
QWidget#gestionLocauxPage QLabel#cardPill[etat="occupe"] { background-color: #E4E8F6; color: #3D4A8A; }
QWidget#gestionLocauxPage QLabel#cardPill[etat="hors"] { background-color: #FCE9CF; color: #9A5B12; }
QWidget#gestionLocauxPage QFrame#panelCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E9EB;
    border-radius: 12px;
}
QWidget#gestionLocauxPage QLabel#panelKicker {
    color: #8A989E;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QWidget#gestionLocauxPage QLabel#panelTitle {
    color: #2F6E7E;
    font-size: 20px;
    font-weight: 700;
}
QWidget#gestionLocauxPage QLabel#panelSection {
    color: #2B4B57;
    font-size: 15px;
    font-weight: 700;
}
QWidget#gestionLocauxPage QLabel#panelInfo {
    color: #6B7B82;
    font-size: 12px;
}
QWidget#gestionLocauxPage QLabel#panelBig {
    color: #2B4B57;
    font-size: 24px;
    font-weight: 700;
}
QProgressBar#occBar {
    border: none;
    background-color: #E5ECEE;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar#occBar::chunk { background-color: #EA9941; border-radius: 4px; }
