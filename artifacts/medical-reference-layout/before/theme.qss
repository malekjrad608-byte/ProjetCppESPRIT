QMainWindow, QDialog { background: #F3F7F8; }
QWidget { color: #293F47; font-family: 'Segoe UI'; font-size: 12px; }
QLabel { background: transparent; border: none; }
QLabel[role="muted"] { color: #7C8987; font-size: 12px; }
QLabel[role="eyebrow"] { color: #748681; font-size: 10px; font-weight: 700; letter-spacing: 1.8px; }
QLabel[role="title"] { color: #306D7B; font-size: 23px; font-weight: 700; }
QLabel[role="section"] { color: #293F47; font-size: 15px; font-weight: 600; }
QFrame#sidebar { background: #FFFFFF; border-right: 1px solid #E1EBEF; }
QFrame#sidebar QLabel[role="muted"] { color: #617D80; }
QFrame#sidebar QLabel[role="eyebrow"] { color: #58767A; }
QFrame#sidebar QFrame#workspace { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #A6D7DF,stop:1 #78B5C1); border: none; }
QFrame#sidebar QPushButton[role="nav"] { color: #526F76; }
QFrame#sidebar QPushButton[role="nav"]:hover { background: rgba(255,255,255,180); color: #2D6C78; }
QFrame#sidebar QPushButton[role="nav"]:checked { background: #CBE3E5; color: #235E6C; }
QFrame#sidebar QPushButton[role="nav"]:disabled { color: #8A9E9F; background: transparent; }
QFrame#topbar { background: #FFFFFF; border-bottom: 1px solid #E0E9EC; }
QFrame[role="card"] { background: #FFFFFF; border: 1px solid #D7E9ED; border-radius: 12px; }
QFrame#hero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #E3F1F4,stop:0.65 #EEF6F6,stop:1 #FBF1DE); border: 1px solid #D6E6EB; border-radius: 16px; }
QFrame#careCard { background: #FFF1DA; border: 1px solid #F1DFC0; border-radius: 8px; }
QFrame#workspace { background: #EAF2F5; border: 1px solid #DCE7EC; border-radius: 10px; }
QPushButton { background: #FFFFFF; border: 1px solid #DCE7EC; border-radius: 7px; padding: 8px 14px; font-weight: 600; color: #3A5D68; }
QPushButton:hover { background: #F0F6F8; border-color: #93BAC5; }
QPushButton:pressed { background: #DCEBF0; }
QPushButton:focus { border: 1px solid #428798; }
QPushButton:disabled { color: #A4B0AA; border-color: #E9EDE9; background: #F7F9F6; }
QPushButton[role="primary"] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #418997,stop:1 #225C68); border: 1px solid #377E8E; color: white; }
QPushButton[role="primary"]:hover { background: #285F6C; border-color: #285F6C; }
QPushButton[role="primary"]:disabled { background: #AABDB4; border-color: #AABDB4; }
QPushButton[role="link"] { background: transparent; border: none; color: #2B715B; padding: 5px 2px; }
QPushButton[role="link"]:hover { color: #163C30; background: #EDF4EC; }
QPushButton[role="danger"] { color: white; border-color: #B56761; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #D17B74,stop:1 #A65450); }
QPushButton[role="danger"]:hover { background: #B86459; border-color: #E7A342; }
QPushButton[role="danger"]:disabled { color: #B6AAA2; border-color: #EBE7E1; background: #F8F7F3; }
QPushButton[role="nav"] { text-align: left; background: transparent; color: #788C94; border: none; padding: 10px 15px; border-radius: 8px; font-weight: 500; }
QPushButton[role="nav"]:hover { background: #F0F6F8; color: #306D7B; }
QPushButton[role="nav"]:checked { background: #DDEBF0; color: #306D7B; font-weight: 700; }
QPushButton[role="nav"]:disabled { color: #99A59F; background: transparent; }
QLineEdit, QTextEdit, QComboBox, QDateTimeEdit, QSpinBox, QDoubleSpinBox { background: #FFFFFF; border: 1px solid #DCE7EC; border-radius: 7px; padding: 7px 10px; color: #344F5B; selection-background-color: #D5E7DC; selection-color: #1E5341; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #4A899B; }
QLineEdit[invalid="true"] { border: 1px solid #C26B5E; background: #FFF8F4; }
QComboBox { padding-right: 27px; }
QComboBox::drop-down { border: none; width: 25px; }
QComboBox::down-arrow, QDateTimeEdit::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/down.xpm); width: 8px; height: 5px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/up.xpm); width: 8px; height: 5px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; background: #F0F5EE; border: none; border-top-right-radius: 7px; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; background: #F0F5EE; border: none; border-bottom-right-radius: 7px; }
QDateTimeEdit::drop-down { subcontrol-origin: border; subcontrol-position: top right; width: 25px; border: none; }
QComboBox QAbstractItemView { background: white; border: 1px solid #DCE7EC; selection-background-color: #DFEDE2; selection-color: #234D3A; padding: 4px; }
QTableWidget { background: #FFFFFF; alternate-background-color: #FFFFFF; border: none; gridline-color: #EDF0EB; selection-background-color: #EFF5EC; selection-color: #264B3F; }
QTableWidget::item { padding: 10px 13px; border-bottom: 1px solid #EDF0EB; }
QTableWidget::item:focus { outline: none; }
/* Stock uses QTableView, not QTableWidget: define its alternate row color
   explicitly so Windows' dark/accent palette cannot bleed into the table. */
QTableView#stockTable { background:#FFFFFF; alternate-background-color:#F4F9FA; color:#263B42; border:1px solid #D8E9EC; gridline-color:#E2EEF0; selection-background-color:#DDEEF1; selection-color:#243D45; outline:0; }
QTableView#stockTable::item:selected { background:#DDEEF1; color:#243D45; }
QTableView#stockTable::item:hover { background:#FFF0DA; color:#795126; }
QTableView#stockTable::item:selected:hover { background:#FFE8C7; color:#614315; }
QHeaderView { background: #F4F8FA; }
QHeaderView::section { background: #3C8190; color: #FFFFFF; font-size: 10px; font-weight: 600; letter-spacing: 1px; border: none; border-bottom: 1px solid #E9EEE7; padding: 13px; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { border: none; background: transparent; width: 7px; margin: 3px; }
QScrollBar::handle:vertical { background: #D0E5EA; min-height: 28px; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 7px; background: transparent; }
QScrollBar::handle:horizontal { background: #D0E5EA; min-width: 24px; border-radius: 3px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QProgressBar { border: none; background: #F0F3ED; border-radius: 3px; min-height: 6px; max-height: 6px; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #72ADB3,stop:1 #377E8E); border-radius: 3px; }
QToolTip { background: #244F3F; color: white; border: none; padding: 7px; }
QCalendarWidget QWidget { background: white; color: #2C5142; }
QCalendarWidget QToolButton { color: #2C5142; background: #ECF4EC; padding: 5px; }
QMenu { background: white; border: 1px solid #DAE4DB; padding: 5px; }
QMenu::item { padding: 9px 25px; }
QMenu::item:selected { background: #E5F0F4; }
QPushButton[role="toggle"] { padding: 8px 11px; color: #71909D; }
QPushButton[role="toggle"]:checked { background: #DDEBF0; border-color: #BBD5DE; color: #346F7D; }
QPushButton::menu-indicator { image: url(:/icons/down.xpm); subcontrol-position: right center; right: 7px; }
QStackedWidget { background: transparent; }

QPushButton[role="success"] { color:white; border:1px solid #53A16A; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #69BB7D,stop:1 #418D57); }
QPushButton[role="success"]:hover { background:#4B9C62; border-color:#E7A342; }
QPushButton[role="success"]:disabled { background:#B5CDBB; border-color:#B5CDBB; color:#EDF4EF; }
QPushButton[detailAction="true"] { border-radius:10px; font-size:13px; font-weight:700; padding:9px 12px; }
QFrame#serviceDetailPanel { border-radius:10px; border-color:#D7E8EE; }
QTableView::item:hover { background:#FFF0DA; color:#795126; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background:#F0A342; }
QMenu::item:selected { background:#FFF0DA; color:#86521D; }

/* Employés, Services et Stock partagent les couleurs et composants du centre. */
QFrame#cardEmploye, QFrame#cardEmployeSelected { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F8FCFD); border:1px solid #D7E9ED; border-radius:12px; }
QFrame#cardEmployeSelected { background:#FFFAF2; border:2px solid #F5A133; }
QFrame#cardEmploye:hover, QFrame#cardEmploye:focus, QFrame#cardEmployeSelected:hover, QFrame#cardEmployeSelected:focus { border-color:#FF9B28; }
QFrame#employeeDetailPanel { background:white; border:1px solid #D7E8EE; border-radius:12px; }
QWidget#employeesPage QPushButton[role="primary"], QWidget#employeesPage QPushButton[role="success"], QWidget#employeesPage QPushButton[role="danger"] { border-radius:10px; }
QDialog QDialogButtonBox QPushButton { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #418997,stop:1 #225C68); color:white; border:1px solid #377E8E; }

/* Integrated Locaux: scoped typography, panels and filter chips. */
#locauxPage #kicker { font-size: 11px; font-weight: 700; color: #6f8a92; }
#locauxPage #h1 { font-size: 30px; font-weight: 700; color: #1f5560; }
#locauxPage #sub { color: #6f8a92; }
#locauxPage #key { color: #6f8a92; }
#locauxPage #panelName { font-size: 23px; font-weight: 700; color: #1f5560; }
#locauxPage #panelTitle { font-size: 15px; font-weight: 700; color: #1d3b44; }
#locauxPage #big { font-size: 30px; font-weight: 700; color: #1f5560; }
#locauxPage #toast {
    background: #1f5560; color: white; border-radius: 12px;
    padding: 12px 22px; font-weight: 600;
}
#locauxPage #panel { background: white; border: 1px solid #e1ebee; border-radius: 14px; }
#locauxPage QPushButton[chip="true"] { border-radius: 18px; padding: 8px 18px; border: 1px solid transparent; }
#locauxPage QPushButton[chip="true"][tone="green"] { background: #e3f3e9; color: #2e8b57; }
#locauxPage QPushButton[chip="true"][tone="blue"] { background: #e6e9f8; color: #4a63b8; }
#locauxPage QPushButton[chip="true"][tone="orange"] { background: #fff4e2; color: #b97712; }
#locauxPage QPushButton[chip="true"][tone="red"] { background: #fbe9e8; color: #c0504d; }
#locauxPage QPushButton[chip="true"][tone="green"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QPushButton[chip="true"][tone="blue"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QPushButton[chip="true"][tone="orange"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QPushButton[chip="true"][tone="red"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QProgressBar { background: #e1ebee; border: none; border-radius: 5px; min-height: 10px; max-height: 10px; }
#locauxPage QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2f7482, stop:1 #6bb3c1);
}
#locauxPage #statsTitle { font-size: 24px; font-weight: 700; color: #1f5560; }
#locauxPage QPushButton[role="ghost"][alert="critical"] { background: #fbe9e8; border-color: #e8b7b5; color: #c0504d; font-weight: 700; }
#locauxPage QPushButton[role="ghost"][alert="critical"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QPushButton[role="ghost"][alert="warning"] { background: #fff4e2; border-color: #efd3a1; color: #b97712; font-weight: 700; }
#locauxPage QPushButton[role="ghost"][alert="warning"]:hover {background:#FFF3DF; border-color:#F59E0B; color:#B56D10;}
#locauxPage QPushButton[chip="true"][on="true"] { border: 2px solid #1f5560; font-weight: 700; }
#locauxPage #h1 { font-size:26px; }
#locauxPage #panelName { font-size:20px; }
#locauxPage QPushButton[chip="true"] { padding:6px 11px; }
#locauxPage QPushButton[role="ghost"]:checked { background:#DDEEF1; border-color:#BEDBE1; }

/* Medical module shares the same surfaces, orange hover and button roles. */
#medicalPage QLabel[role="pageTitle"] { font-size:26px; font-weight:700; color:#286D7B; }
#medicalPage #recordCard { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F8FCFD); border:1px solid #D7E9ED; border-radius:12px; }
#medicalPage #recordCard[selected="true"] { background:#FFFAF2; border:2px solid #F5A133; }
#medicalPage #recordCard:hover { border-color:#FF9B28; }
#medicalPage #recordTitle { font-size:17px; font-weight:700; color:#245A68; }
#medicalPage #recordSub, #medicalPage #recordMeta { color:#738D96; font-size:12px; }
#medicalPage #statusPill { color:#477D8B; font-size:12px; }
#medicalPage #cardBadge, #medicalBadge { border-radius:8px; padding:5px 8px; font-size:11px; }
#medicalPage #cardBadge[tone="ok"], #medicalBadge[tone="ok"] { background:#E3F3E9; color:#27834A; }
#medicalPage #cardBadge[tone="warn"], #medicalBadge[tone="warn"] { background:#FFF0D9; color:#AE6B13; }
#medicalChip { border-radius:10px; padding:10px 13px; font-size:12px; }
#medicalChip[tone="blue"] { background:#E3F0F3; color:#36768A; }
#medicalChip[tone="ok"] { background:#E3F3E9; color:#27834A; }
#medicalChip[tone="warn"] { background:#FFF0D9; color:#AE6B13; }
#medicalDetailPanel { background:white; border:1px solid #D7E8EE; border-radius:12px; }
#medicalError { background:#FCEBE8; color:#A9473E; border-radius:8px; padding:10px; }
#medicalrecorddialog #dialogCard, #medicalrecorddetailsdialog #dialogCard { background:white; border:1px solid #D7E8EE; border-radius:10px; padding:10px; }
#medicalrecorddialog #cardTitle, #medicalrecorddetailsdialog #cardTitle { font-size:16px; font-weight:700; color:#286D7B; padding:0 0 9px 0; }
#medicalrecorddialog QTextEdit { border:1px solid #CFE1E7; border-radius:7px; background:white; padding:6px; }
#medicalrecorddialog QTextEdit:focus { border-color:#F5A133; }
#medicalrecorddialog QLineEdit:read-only { background:#EEF5F7; color:#78929B; }
#medicalrecorddetailsdialog #historyTable, #medicalStatsTable { background:white; alternate-background-color:#F4F9FA; color:#294C56; selection-background-color:#DDEEF1; selection-color:#294C56; }
#medicalrecorddetailsdialog #historyTable::item:hover, #medicalStatsTable::item:hover { background:#FFF2DE; color:#785326; }
#medicalRate { min-height:18px; max-height:18px; margin:10px 6px; background:#E3F0F3; color:#294C56; border:0; border-radius:5px; text-align:center; }
#medicalRate::chunk { background:#79BCC7; border-radius:5px; }
