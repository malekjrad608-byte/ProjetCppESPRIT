+int ClinicMap::roomAt(const QPointF &pt) const
+{
+    for (int i = m_hit.size() - 1; i >= 0; --i)   // la boite dessinee en dernier est devant
+        if (m_hit[i].second.contains(pt))
+            return m_hit[i].first;
     return 0;
