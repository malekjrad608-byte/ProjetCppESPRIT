
  CREATE TABLE "RAWAND"."EMPLOYES"
   (	"ID" NUMBER(10,0),
	"NOM" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"PRENOM" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"COURRIEL" VARCHAR2(250 CHAR),
	"TELEPHONE" VARCHAR2(60 CHAR),
	"POSTE" VARCHAR2(150 CHAR),
	"DATE_EMBAUCHE" VARCHAR2(10 CHAR),
	"DISPONIBLE" NUMBER(1,0) DEFAULT 1,
	"CHARGE_HEBDO" NUMBER(8,2) DEFAULT 0,
	"DISPO_HEBDO" NUMBER(8,2) DEFAULT 35,
	"COMPETENCES" VARCHAR2(2000 CHAR),
	"ID_SERVICE" NUMBER(10,0) NOT NULL ENABLE,
	 CHECK (disponible IN (0,1)) ENABLE,
	 CHECK (charge_hebdo>=0) ENABLE,
	 CHECK (dispo_hebdo>=0) ENABLE,
	 PRIMARY KEY ("ID")
  USING INDEX  ENABLE,
	 CONSTRAINT "UQ_EMPLOYEE_TEAM" UNIQUE ("ID", "ID_SERVICE")
  USING INDEX  ENABLE
   ) ;


  CREATE TABLE "RAWAND"."LOCAUX"
   (	"ID" NUMBER(10,0),
	"NAME" VARCHAR2(150 CHAR) NOT NULL ENABLE,
	"TYPE" VARCHAR2(100 CHAR) NOT NULL ENABLE,
	"FLOOR" NUMBER(3,0) NOT NULL ENABLE,
	"CAPACITY" NUMBER(6,0) NOT NULL ENABLE,
	"OCCUPANCY" NUMBER(6,0) NOT NULL ENABLE,
	"SPECIALTY" VARCHAR2(250 CHAR),
	"OUT_OF_SERVICE" NUMBER(1,0) NOT NULL ENABLE,
	"CLEANING" NUMBER(1,0) NOT NULL ENABLE,
	"LAST_CLEANED" VARCHAR2(35 CHAR),
	"DIRTY_SINCE" VARCHAR2(35 CHAR),
	"ID_SERVICE" NUMBER(10,0) NOT NULL ENABLE,
	 CHECK (capacity>=1) ENABLE,
	 CHECK (out_of_service IN (0,1)) ENABLE,
	 CHECK (cleaning IN (0,1,2)) ENABLE,
	 CHECK (occupancy BETWEEN 0 AND capacity) ENABLE,
	 PRIMARY KEY ("ID")
  USING INDEX  ENABLE
   ) ;


  CREATE TABLE "RAWAND"."MEDICAL_RECORDS"
   (	"ID" NUMBER(10,0),
	"ANIMAL_ID" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"NAME" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"SPECIES" VARCHAR2(30 CHAR) NOT NULL ENABLE,
	"BREED" VARCHAR2(120 CHAR),
	"AGE" NUMBER(2,0) NOT NULL ENABLE,
	"SEX" VARCHAR2(20 CHAR) NOT NULL ENABLE,
	"OWNER" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"CONSULTATION_DATE" VARCHAR2(10 CHAR) NOT NULL ENABLE,
	"REASON" CLOB,
	"DIAGNOSIS" CLOB,
	"TREATMENT" CLOB,
	"VACCINATIONS" CLOB,
	"ALLERGIES" CLOB,
	"WEIGHT" NUMBER(6,2) NOT NULL ENABLE,
	"OBSERVATIONS" CLOB,
	"VACCINATION_STATUS" VARCHAR2(30 CHAR) NOT NULL ENABLE,
	"ID_EMPLOYE" NUMBER(10,0) NOT NULL ENABLE,
	 CHECK (age BETWEEN 0 AND 30) ENABLE,
	 CHECK (weight BETWEEN 0 AND 100) ENABLE,
	 CHECK (vaccination_status IN ('À jour','À renouveler')) ENABLE,
	 PRIMARY KEY ("ID")
  USING INDEX  ENABLE
   ) ;


  CREATE TABLE "RAWAND"."SERVICES"
   (	"ID" NUMBER(10,0),
	"NAME" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"DESCRIPTION" CLOB,
	"RESPONSIBLE" VARCHAR2(250 CHAR),
	"CATEGORY" VARCHAR2(120 CHAR) NOT NULL ENABLE,
	"DATETIME" VARCHAR2(35 CHAR) NOT NULL ENABLE,
	"STATUS" VARCHAR2(30 CHAR) NOT NULL ENABLE,
	"DURATION" NUMBER(4,0) NOT NULL ENABLE,
	"PRICE" NUMBER(10,2) NOT NULL ENABLE,
	"CLIENTNAME" VARCHAR2(120 CHAR),
	"INVOICENUMBER" VARCHAR2(60 CHAR),
	"INVOICEDATE" VARCHAR2(35 CHAR),
	"ID_EMPLOYE" NUMBER(10,0) NOT NULL ENABLE,
	"INVOICE_STATUS" VARCHAR2(12 CHAR) DEFAULT 'BROUILLON' NOT NULL ENABLE,
	"INVOICE_EMITTED_AT" VARCHAR2(35 CHAR),
	 CHECK (status IN ('Planifié','En cours','Terminé','Annulé')) ENABLE,
	 CHECK (duration BETWEEN 5 AND 1440) ENABLE,
	 CHECK (price BETWEEN 0 AND 99999.99) ENABLE,
	 PRIMARY KEY ("ID")
  USING INDEX  ENABLE,
	 UNIQUE ("INVOICENUMBER")
  USING INDEX  ENABLE,
	 CONSTRAINT "CK_SERVICE_INVOICE" CHECK (invoice_status IN ('BROUILLON','EMISE','ANNULEE')) ENABLE
   ) ;


  CREATE TABLE "RAWAND"."STOCK_LOTS"
   (	"LOT" VARCHAR2(120 CHAR),
	"ARTICLE" VARCHAR2(250 CHAR) NOT NULL ENABLE,
	"CATEGORY" VARCHAR2(100 CHAR) NOT NULL ENABLE,
	"QUANTITY" NUMBER(6,0) NOT NULL ENABLE,
	"UNIT" VARCHAR2(60 CHAR) NOT NULL ENABLE,
	"THRESHOLD" NUMBER(6,0) NOT NULL ENABLE,
	"EXPIRY" VARCHAR2(10 CHAR) NOT NULL ENABLE,
	"ID_LOCAL" NUMBER(10,0) NOT NULL ENABLE,
	 CHECK (quantity BETWEEN 0 AND 999999) ENABLE,
	 CHECK (threshold BETWEEN 1 AND 999999) ENABLE,
	 PRIMARY KEY ("LOT")
  USING INDEX  ENABLE
   ) ;


  ALTER TABLE "RAWAND"."EMPLOYES" ADD CONSTRAINT "FK_EMPLOYE_SERVICE" FOREIGN KEY ("ID_SERVICE")
	  REFERENCES "RAWAND"."SERVICES" ("ID") DEFERRABLE INITIALLY DEFERRED ENABLE;


  ALTER TABLE "RAWAND"."LOCAUX" ADD CONSTRAINT "FK_LOCAL_SERVICE" FOREIGN KEY ("ID_SERVICE")
	  REFERENCES "RAWAND"."SERVICES" ("ID") ENABLE;


  ALTER TABLE "RAWAND"."MEDICAL_RECORDS" ADD CONSTRAINT "FK_MEDICAL_EMPLOYE" FOREIGN KEY ("ID_EMPLOYE")
	  REFERENCES "RAWAND"."EMPLOYES" ("ID") ENABLE;


  ALTER TABLE "RAWAND"."SERVICES" ADD CONSTRAINT "FK_SERVICE_TEAM" FOREIGN KEY ("ID_EMPLOYE", "ID")
	  REFERENCES "RAWAND"."EMPLOYES" ("ID", "ID_SERVICE") DEFERRABLE INITIALLY DEFERRED ENABLE;


  ALTER TABLE "RAWAND"."STOCK_LOTS" ADD CONSTRAINT "FK_STOCK_LOCAL" FOREIGN KEY ("ID_LOCAL")
	  REFERENCES "RAWAND"."LOCAUX" ("ID") ENABLE;


  CREATE OR REPLACE NONEDITIONABLE TRIGGER "RAWAND"."EMPLOYES_BI" BEFORE INSERT ON employes FOR EACH ROW
BEGIN IF :NEW.id IS NULL THEN :NEW.id := employes_seq.NEXTVAL; END IF; END;
/
ALTER TRIGGER "RAWAND"."EMPLOYES_BI" ENABLE;


  CREATE OR REPLACE NONEDITIONABLE TRIGGER "RAWAND"."MEDICAL_RECORDS_BI" BEFORE INSERT ON medical_records FOR EACH ROW
BEGIN IF :NEW.id IS NULL THEN :NEW.id := medical_records_seq.NEXTVAL; END IF; END;
/
ALTER TRIGGER "RAWAND"."MEDICAL_RECORDS_BI" ENABLE;


  CREATE OR REPLACE NONEDITIONABLE TRIGGER "RAWAND"."SERVICES_BI" BEFORE INSERT ON services FOR EACH ROW
BEGIN
 IF :NEW.id IS NULL THEN :NEW.id := services_seq.NEXTVAL; END IF;
 IF :NEW.invoiceNumber IS NULL THEN
  :NEW.invoiceNumber := 'FAC-' || SUBSTR(:NEW.dateTime,1,4) || '-' || LPAD(TO_CHAR(:NEW.id),GREATEST(6,LENGTH(TO_CHAR(:NEW.id))),'0');
  :NEW.invoiceDate := TO_CHAR(SYSTIMESTAMP,'YYYY-MM-DD"T"HH24:MI:SS');
 END IF;
END;
/
ALTER TRIGGER "RAWAND"."SERVICES_BI" ENABLE;


  CREATE UNIQUE INDEX "RAWAND"."LOCAUX_NAME_CI" ON "RAWAND"."LOCAUX" (LOWER("NAME"))
  ;

