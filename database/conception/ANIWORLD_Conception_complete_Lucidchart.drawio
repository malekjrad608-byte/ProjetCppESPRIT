: VARCHAR2(120)&#10;email ? : VARCHAR2(150)&#10;telephone ? : VARCHAR2(30)&#10;poste : VARCHAR2(120)&#10;date_embauche ? : DATE&#10;heures_hebdo : NUMBER(6,2)&#10;habilitation_medicale : NUMBER(1)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="COMPTE" value="COMPTE&#10;&#10;PK id_compte : NUMBER(10)&#10;FK UQ id_employe ? : NUMBER(10) -&gt; EMPLOYE&#10;login : VARCHAR2(80)&#10;role : VARCHAR2(20)&#10;sel : RAW(24)&#10;empreinte : RAW(32)&#10;iterations : NUMBER(7)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="COMPETENCE" value="COMPETENCE&#10;&#10;PK id_competence : NUMBER(10)&#10;libelle : VARCHAR2(120)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: libelle" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="EMPLOYE_COMPETENCE" value="EMPLOYE_COMPETENCE&#10;&#10;PK FK id_employe : NUMBER(10) -&gt; EMPLOYE&#10;PK FK id_competence : NUMBER(10) -&gt; COMPETENCE&#10;date_validation ? : DATE&#10;valide_jusquau ? : DATE" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="440" height="480" as="geometry" /></mxCell><mxCell id="CRENEAU_EMPLOYE" value="CRENEAU_EMPLOYE&#10;&#10;PK id_creneau_employe : NUMBER(10)&#10;FK id_employe : NUMBER(10) -&gt; EMPLOYE&#10;debut : TIMESTAMP&#10;fin : TIMESTAMP&#10;type_creneau : VARCHAR2(20)&#10;motif ? : VARCHAR2(250)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="440" height="480" as="geometry" /></mxCell><mxCell id="SERVICE_COMPETENCE" value="SERVICE_COMPETENCE&#10;&#10;PK FK id_service : NUMBER(10) -&gt; SERVICE&#10;PK FK id_competence : NUMBER(10) -&gt; COMPETENCE" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="690" width="440" height="480" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="MPD 3 - Locaux et stock" id="p10"><mxGraphModel page="1" pageScale="1" pageWidth="1440" pageHeight="1220" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ANIWORLD / MPD COMMUN / 3 sur 4" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#CEE4E9;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="65" as="geometry" /></mxCell><mxCell id="legend" value="PK = cle primaire | FK = cle etrangere | UQ = unique | ? = facultatif&#10;Les references FK relient aussi les tables des autres pages. Modele cible S5 : migration Qt distincte." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1380" height="75" as="geometry" /></mxCell><mxCell id="LOCAL" value="LOCAL&#10;&#10;PK id_local : NUMBER(10)&#10;nom : VARCHAR2(120)&#10;type_local : VARCHAR2(80)&#10;etage : NUMBER(3)&#10;capacite : NUMBER(6)&#10;surface_m2 ? : NUMBER(8,2)&#10;equipements ? : CLOB&#10;etat : VARCHAR2(20)&#10;seuil_entretien_h : NUMBER(8,2)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="INTERVENTION_LOCAL" value="INTERVENTION_LOCAL&#10;&#10;PK id_intervention_local : NUMBER(10)&#10;FK id_local : NUMBER(10) -&gt; LOCAL&#10;FK id_employe : NUMBER(10) -&gt; EMPLOYE&#10;type_intervention : VARCHAR2(20)&#10;debut : TIMESTAMP&#10;fin ? : TIMESTAMP&#10;statut : VARCHAR2(20)&#10;controle_valide : NUMBER(1)&#10;observations ? : CLOB&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="STOCK" value="STOCK&#10;&#10;PK id_stock : NUMBER(10)&#10;FK id_local ? : NUMBER(10) -&gt; LOCAL&#10;nom : VARCHAR2(120)&#10;description ? : CLOB&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: nom" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="ARTICLE" value="ARTICLE&#10;&#10;PK id_article : NUMBER(10)&#10;reference : VARCHAR2(80)&#10;designation : VARCHAR2(150)&#10;categorie : VARCHAR2(80)&#10;unite : VARCHAR2(30)&#10;seuil_alerte : NUMBER(12,3)&#10;prix_unitaire_tnd : NUMBER(12,3)&#10;fournisseur ? : VARCHAR2(150)&#10;delai_fournisseur_j : NUMBER(5)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: reference" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="440" height="480" as="geometry" /></mxCell><mxCell id="LOT_STOCK" value="LOT_STOCK&#10;&#10;PK id_lot_stock : NUMBER(10)&#10;FK id_article : NUMBER(10) -&gt; ARTICLE&#10;FK id_stock : NUMBER(10) -&gt; STOCK&#10;numero_lot : VARCHAR2(100)&#10;quantite : NUMBER(12,3)&#10;date_peremption ? : DATE&#10;bloque : NUMBER(1)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: id_article + id_stock + numero_lot" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="440" height="480" as="geometry" /></mxCell><mxCell id="MOUVEMENT_STOCK" value="MOUVEMENT_STOCK&#10;&#10;PK id_mouvement_stock : NUMBER(10)&#10;FK id_lot_stock : NUMBER(10) -&gt; LOT_STOCK&#10;FK id_compte : NUMBER(10) -&gt; COMPTE&#10;FK id_service ? : NUMBER(10) -&gt; SERVICE&#10;type_mouvement : VARCHAR2(10)&#10;quantite : NUMBER(12,3)&#10;date_mouvement : TIMESTAMP&#10;motif : VARCHAR2(500)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="690" width="440" height="480" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="MPD 4 - Factures et adoptions" id="p11"><mxGraphModel page="1" pageScale="1" pageWidth="1440" pageHeight="1220" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ANIWORLD / MPD COMMUN / 4 sur 4" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#CEE4E9;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="65" as="geometry" /></mxCell><mxCell id="legend" value="PK = cle primaire | FK = cle etrangere | UQ = unique | ? = facultatif&#10;Les references FK relient aussi les tables des autres pages. Modele cible S5 : migration Qt distincte." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1380" height="75" as="geometry" /></mxCell><mxCell id="FACTURE" value="FACTURE&#10;&#10;PK id_facture : NUMBER(10)&#10;FK UQ id_consultation : NUMBER(10) -&gt; CONSULTATION&#10;FK id_client : NUMBER(10) -&gt; CLIENT&#10;numero : VARCHAR2(40)&#10;date_emission : TIMESTAMP&#10;nom_client_facture : VARCHAR2(250)&#10;adresse_client_facture ? : VARCHAR2(500)&#10;statut : VARCHAR2(20)&#10;date_paiement ? : TIMESTAMP&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: numero" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="LIGNE_FACTURE" value="LIGNE_FACTURE&#10;&#10;PK FK id_facture : NUMBER(10) -&gt; FACTURE&#10;PK numero_ligne : NUMBER(4)&#10;designation : VARCHAR2(500)&#10;quantite : NUMBER(10,3)&#10;prix_unitaire_tnd : NUMBER(12,3)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="ADOPTANT" value="ADOPTANT&#10;&#10;PK id_adoptant : NUMBER(10)&#10;FK UQ id_client : NUMBER(10) -&gt; CLIENT&#10;logement : VARCHAR2(100)&#10;espace_exterieur : NUMBER(1)&#10;nombre_enfants : NUMBER(3)&#10;autres_animaux ? : CLOB&#10;experience ? : CLOB&#10;disponibilite ? : VARCHAR2(250)&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="440" height="480" as="geometry" /></mxCell><mxCell id="ADOPTION" value="ADOPTION&#10;&#10;PK id_adoption : NUMBER(10)&#10;FK id_animal : NUMBER(10) -&gt; ANIMAL&#10;FK id_adoptant : NUMBER(10) -&gt; ADOPTANT&#10;FK id_employe : NUMBER(10) -&gt; EMPLOYE&#10;date_demande : DATE&#10;statut : VARCHAR2(20)&#10;date_decision ? : DATE&#10;date_placement ? : DATE&#10;pieces_verifiees : NUMBER(1)&#10;rencontre_effectuee : NUMBER(1)&#10;accord_responsable : NUMBER(1)&#10;observations ? : CLOB&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="440" height="480" as="geometry" /></mxCell><mxCell id="SUIVI_ADOPTION" value="SUIVI_ADOPTION&#10;&#10;PK id_suivi_adoption : NUMBER(10)&#10;FK id_adoption : NUMBER(10) -&gt; ADOPTION&#10;FK id_compte ? : NUMBER(10) -&gt; COMPTE&#10;jalon_jours : NUMBER(2)&#10;date_prevue : DATE&#10;date_contact ? : TIMESTAMP&#10;statut : VARCHAR2(20)&#10;resultat ? : CLOB&#10;cree_le : TIMESTAMP&#10;modifie_le : TIMESTAMP&#10;archive : NUMBER(1)&#10;&#10;UQ: id_adoption + jalon_jours" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="440" height="480" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Reunion - questions et ameliorations" id="p12"><mxGraphModel page="1" pageScale="1" pageWidth="1440" pageHeight="1220" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ANIWORLD / PREPARER LA REUNION" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#CEE4E9;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="65" as="geometry" /></mxCell><mxCell id="legend" value="Questions probables et ameliorations proposees a partir du schema initial. Reponses a adapter aux choix valides avec la professeure." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1380" height="75" as="geometry" /></mxCell><mxCell id="q0" value="1. Pourquoi retirer RH ?&#10;&#10;Le besoin porte sur la gestion des employes et leurs affectations. Conserver EMPLOYE, COMPETENCE et CRENEAU_EMPLOYE ; eviter un module RH redondant." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="675" height="225" as="geometry" /></mxCell><mxCell id="q1" value="2. Article et stock : quelles cardinalites ?&#10;&#10;Un ARTICLE peut avoir plusieurs LOT_STOCK ; chaque lot concerne un seul article et un seul STOCK. Quantite et peremption appartiennent au lot." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="735" y="190" width="675" height="225" as="geometry" /></mxCell><mxCell id="q2" value="3. Un animal peut-il avoir plusieurs dossiers ?&#10;&#10;Un seul dossier longitudinal par animal, plusieurs consultations dans ce dossier. La FK id_animal est unique dans DOSSIER_MEDICAL." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="435" width="675" height="225" as="geometry" /></mxCell><mxCell id="q3" value="4. Service et consultation : quelle difference ?&#10;&#10;SERVICE est la prestation planifiee. CONSULTATION est son acte clinique. Le service et le dossier doivent designer le meme animal." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="735" y="435" width="675" height="225" as="geometry" /></mxCell><mxCell id="q4" value="5. Comment generer une facture fiable ?&#10;&#10;Creer FACTURE et LIGNE_FACTURE dans la transaction de validation. Figer le client et les prix a l emission ; exporter en PDF." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="675" height="225" as="geometry" /></mxCell><mxCell id="q5" value="6. Comment empecher deux adoptions actives ?&#10;&#10;Plusieurs candidatures possibles, une seule adoption VALIDEE non archivee par animal. Index conditionnel Oracle + transaction de validation." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="735" y="680" width="675" height="225" as="geometry" /></mxCell><mxCell id="q6" value="7. Quels controles sont dans Oracle ?&#10;&#10;PK, FK, UNIQUE, CHECK, precision monetaire et historique des mouvements. Disponibilites, habilitations et workflows necessitent encore le code transactionnel." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="925" width="675" height="225" as="geometry" /></mxCell><mxCell id="q7" value="8. Est-ce deja le schema utilise par Qt ?&#10;&#10;Non. Qt utilise ANIWORLD_APP (11 tables). Le modele cible (23 tables) est teste dans ANIWORLD_S5_MODEL. La migration applicative reste une etape distincte." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#F1F7F8;strokeColor=#267080;fontColor=#203E4B;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="735" y="925" width="675" height="225" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>