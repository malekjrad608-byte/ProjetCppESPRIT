####### Install

install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests mkdir C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests & if not exist C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests\$(TARGET)
	-$(DEL_DIR) C:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.7.3\mingw_64\tests\tests 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

