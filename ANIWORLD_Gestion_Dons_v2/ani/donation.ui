  <property name="styleSheet">
   <string notr="true">
QMainWindow{background:#F4F7F8;}
QWidget{font-family:'Segoe UI';color:#263B42;}
QFrame#sidebar{background:#FFFFFF;border-right:1px solid #DCE6E9;}
QLabel#brandName{color:#225A64;font-size:12pt;font-weight:700;}
QLabel#brandSub{color:#728288;font-size:7pt;}
QLabel#navTitle{color:#7C8D92;font-size:7.5pt;font-weight:700;}
QPushButton#btnDashboard,QPushButton#navServices,QPushButton#navEmployees,QPushButton#navStock,QPushButton#navLocaux,QPushButton#navMedical{background:transparent;color:#4D6269;border:0;border-radius:7px;text-align:left;padding:8px 6px;min-height:18px;font-size:8.5pt;}
QPushButton#btnDashboard:hover,QPushButton#navServices:hover,QPushButton#navEmployees:hover,QPushButton#navStock:hover,QPushButton#navLocaux:hover,QPushButton#navMedical:hover{background:#F4F7F8;color:#225A64;}
QPushButton#navDonations{background:#E4F0F3;color:#225A64;border:0;border-radius:7px;text-align:left;padding:8px 6px;font-weight:700;font-size:8.5pt;}
QLabel#sideWarning{color:#728288;font-size:8pt;}
QLabel#breadcrumb{color:#819197;font-size:9pt;}
QLabel#pageTitle{color:#225A64;font-size:22pt;font-weight:700;}
QLabel#pageSubtitle{color:#728288;font-size:9pt;}
QLabel#roleLabel{color:#5E747C;font-size:9pt;}
QLabel#modeBadge{background:#E6F3EC;color:#397A5C;border-radius:7px;padding:7px 12px;font-weight:600;}
QPushButton#btnStatistics,QPushButton#btnExportCsv,QPushButton#btnExportPdf,QPushButton#btnReset{background:#FFFFFF;color:#225A64;border:1px solid #D6E2E5;border-radius:7px;padding:7px 11px;min-height:20px;}
QPushButton#btnStatistics:hover,QPushButton#btnExportCsv:hover,QPushButton#btnExportPdf:hover,QPushButton#btnReset:hover{background:#E4F0F3;}
QPushButton#btnNew{background:#3B8795;color:#FFFFFF;border:0;border-radius:7px;padding:9px 16px;font-weight:700;min-height:22px;}
QPushButton#btnNew:hover{background:#2F7482;}
QFrame#statCard,QFrame#statCard2,QFrame#statCard3,QFrame#filtersPanel,QFrame#cardsPanel,QFrame#detailPanel{background:#FFFFFF;border:1px solid #DDE7E9;border-radius:9px;}
QFrame#statCard{background:#EAF7EF;border:1px solid #D7EBDD;}
QFrame#statCard2{background:#F0ECFA;border:1px solid #E1D8F3;}
QFrame#statCard3{background:#EAF4F8;border:1px solid #D6E7EE;}
QLabel#statCaption,QLabel#statCaption2,QLabel#statCaption3{color:#718187;font-size:9pt;}
QLabel#statCaption{color:#4D7B61;}
QLabel#statCaption2{color:#76639A;}
QLabel#statCaption3{color:#4D7785;}
QLabel#statTotal,QLabel#statDonors,QLabel#statAverage{color:#2D7655;font-size:15pt;font-weight:700;}
QLabel#statDonors{color:#705A9A;}
QLabel#statAverage{color:#397F8D;}
QLineEdit#editSearch,QComboBox#comboStatus,QComboBox#comboType,QComboBox#comboSort{background:#FFFFFF;color:#263B42;border:1px solid #D6E2E5;border-radius:6px;padding:6px 9px;min-height:26px;}
QLineEdit#editSearch:focus,QComboBox#comboStatus:focus,QComboBox#comboType:focus,QComboBox#comboSort:focus{border:1px solid #397F8D;}
QLabel#countShown{color:#7B8D93;font-size:9pt;}
QScrollArea#cardsScroll{background:#FFFFFF;border:0;}
QWidget#cardsContent{background:#FFFFFF;}
QLabel#detailKicker{color:#7B8C92;font-size:9pt;font-weight:700;letter-spacing:1px;}
QLabel#detailId{color:#225A64;font-size:17pt;font-weight:700;}
QLabel#detailStatus{background:#FFF0D6;color:#A16D1B;border-radius:6px;padding:6px 10px;font-weight:600;}
QLabel#recurringBadge{background:#E6F3EC;color:#397A5C;border-radius:6px;padding:6px 10px;font-weight:600;}
QLabel#anomalyBadge{background:#FBE9E7;color:#AE5751;border-radius:6px;padding:6px 10px;font-weight:600;}
QLabel#detailLabel,QLabel#detailLabel2,QLabel#detailLabel3,QLabel#detailLabel4,QLabel#detailLabel5,QLabel#detailLabel6{color:#728288;font-size:8.5pt;font-weight:600;}
QLineEdit#detailDonor,QLineEdit#detailAmount,QLineEdit#detailDate,QLineEdit#detailPayment,QLineEdit#detailType,QLineEdit#detailCampaign{background:#F9FBFC;color:#263B42;border:1px solid #DCE6E9;border-radius:6px;padding:5px 9px;font-weight:600;min-height:32px;max-height:32px;}
QLabel#footerInfo{color:#8A989D;font-size:8pt;}
QPushButton#btnRecurring,QPushButton#btnAnomalies,QPushButton#btnConsult,QPushButton#btnEdit,QPushButton#btnArchive,QPushButton#btnDelete{background:#FFFFFF;color:#347786;border:1px solid #D7E2E5;border-radius:6px;padding:7px 10px;min-height:20px;}
QPushButton#btnRecurring:hover,QPushButton#btnAnomalies:hover,QPushButton#btnConsult:hover,QPushButton#btnEdit:hover,QPushButton#btnArchive:hover{background:#E4F0F3;border-color:#B9D5DC;}
QPushButton#btnDelete{color:#AE5751;border-color:#E3C4C1;}
QPushButton#btnDelete:hover{background:#FBE9E7;}
QGridLayout{margin:0;}
QScrollBar:vertical{width:7px;background:#F4F7F8;}
QScrollBar::handle:vertical{background:#C8D9D4;border-radius:3px;min-height:28px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0;}
