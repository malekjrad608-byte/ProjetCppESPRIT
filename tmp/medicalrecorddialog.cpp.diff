+// Chiffres saisis après "ANI-" (au plus 9 : REF_ANIMAL est un NUMBER)
+QString MedicalRecordDialog::chiffresRef() const
+{
+    QString t = m_editAnimalRef->text().trimmed();
+    if (t.startsWith(kPrefixeRef, Qt::CaseInsensitive))
+        t = t.mid(kPrefixeRef.size());
+    QString chiffres;
+    for (const QChar c : t)
+        if (c >= QLatin1Char('0') && c <= QLatin1Char('9'))
+            chiffres += c;
+    return chiffres.left(9);
+}
+
+// Référence complète normalisée ("ANI-012"), ou vide si aucun numéro n'est saisi
+QString MedicalRecordDialog::refAnimal() const
+{
+    const QString chiffres = chiffresRef();
+    if (chiffres.isEmpty())
+        return QString();
+    return MedicalRecord::versTexte(QVariant(chiffres.toLongLong()), "ANI");
+}
+
+// Message si la référence saisie est déjà utilisée par un dossier (REF_ANIMAL est unique dans la base)
+QString MedicalRecordDialog::refDejaUtilisee() const
+{
+    const QVariant numero = MedicalRecord::versNombre(refAnimal());
+    if (m_editing || numero.isNull())
+        return QString();
+    for (const MedicalRecord &r : m_existing) {
+        const QVariant autre = MedicalRecord::versNombre(r.getIdAnimal());
+        if (!autre.isNull() && autre.toLongLong() == numero.toLongLong())
+            return QString::fromUtf8("Ce dossier existe déjà : « %1 » (%2), consultation du %3. Utilisez « Modifier ».")
+                .arg(r.getNomAnimal(), r.getIdAnimal(), r.getDateConsultation().toString("dd/MM/yyyy"));
+    }
+    return QString();
+}
+
+// Texte d'avertissement si le même dossier existe déjà (vide sinon)
+QString MedicalRecordDialog::dossierExistant() const
+{
+    if (const QString dejaUtilisee = refDejaUtilisee(); !dejaUtilisee.isEmpty())
+        return dejaUtilisee + QString::fromUtf8("\n\nOuvrez-le dans la liste et utilisez « Modifier » au lieu d'en créer un deuxième.");
+
+    // même animal (nom + espèce + propriétaire) le même jour, même si la référence est vide ou différente
+    const QString nom = m_editAnimalName->text().trimmed();
+    const QString proprio = m_editOwner->text().trimmed();
+    const QString espece = m_comboSpecies->currentText().trimmed();
+    const QDate jour = m_dateConsultation->date();
+    for (const MedicalRecord &r : m_existing) {
+        if (r.getDateConsultation() != jour || nom.isEmpty())
+            continue;
+        if (nom.compare(r.getNomAnimal().trimmed(), Qt::CaseInsensitive) == 0
+            && proprio.compare(r.getProprietaire().trimmed(), Qt::CaseInsensitive) == 0
+            && espece.compare(r.getEspece().trimmed(), Qt::CaseInsensitive) == 0)
+            return QString::fromUtf8("Ce dossier existe déjà : « %1 » (%2) a déjà un dossier pour la consultation du %3.\n\n"
+                                     "Ouvrez-le dans la liste et utilisez « Modifier » au lieu d'en créer un deuxième.")
+                .arg(r.getNomAnimal(), r.getIdAnimal(), jour.toString("dd/MM/yyyy"));
+    }
+    return QString();
+}
+
+// Garde toujours "ANI-" au début et refuse tout sauf les chiffres
+void MedicalRecordDialog::normaliserRef()
+{
+    const QString voulu = kPrefixeRef + chiffresRef();
+    if (m_editAnimalRef->text() != voulu)
+        m_editAnimalRef->setText(voulu);
+}
